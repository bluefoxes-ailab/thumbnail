__pycache__/
*.pyc

# Ephemeral video-processing cache (downloaded videos, extracted frames)
backend/temp/

# Downloaded model weights (re-downloadable, shouldn't be versioned).
# Both locations: facexlib resolves them relative to the process's working
# directory, so running from the repo root lands them here instead.
backend/gfpgan/
/gfpgan/

# The U2-Net cutout weights, 176MB fetched once by the app itself (see
# backend/background_remover.py). Same reasoning as the line above, and the
# same name is excluded from the installer payload — see engine.stage_payload.
backend/models/

# Runtime lock file (live sessionId/pid), not project state
.claude/scheduled_tasks.lock

# Installer build artifacts. The payload is staged from the repo and the
# setup exe is regenerated by installer/build_installer.py, so neither is
# project state; .build-venv is a local toolchain, not a dependency.
installer/build/
installer/dist/
installer/.build-venv/

# Built patches. Regenerated by installer/build_patch.py from the repo, and
# published rather than versioned.
installer/patches/

# The dev-time stand-in for the install's own content folder: channel packs
# belonging to this machine, not to the app.
/content/
runtime/
libs/
*.bat
installer/releases/
*.exe
backend/secrets/
logs/
*.csv
frontend/*.csv
*.save
fonts

# ...except the app's own. The bare `fonts` above matches any folder of that
# name, frontend/fonts/ included, and it did so silently: every face already
# committed stayed tracked, so nothing looked wrong, while every face added
# after it was ignored. A pack whose JSON reached the repo without its font
# file is exactly the broken-title failure installer/README.md describes, and
# build_patch.py only catches it on a machine that happens to have the file.
# The faces are content the packs name, so they are versioned like the packs.
!/frontend/fonts/
